[Unit]
Description=MEXC Terminal Web UI
After=network.target

[Service]
Type=simple
User=mexc
Group=mexc
WorkingDirectory=/opt/mexc-terminal
Environment=NODE_ENV=production
Environment=WEB_PORT=8787
ExecStart=/usr/bin/npm run start:web
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mexc-terminal/config /opt/mexc-terminal/logs

[Install]
WantedBy=multi-user.target
